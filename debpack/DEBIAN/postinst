#!/bin/sh
set -e

MODEL_DIR="/usr/local/share/nems/models"
MODEL_URL="https://huggingface.co/bartowski/Llama-3.2-1B-Instruct-GGUF/resolve/main/Llama-3.2-1B-Instruct-Q4_K_M.gguf"
MODEL_FILE="${MODEL_DIR}/nems-ai.gguf"

echo "Setting up NEMS AI environment..."

# Ensure directory exists
mkdir -p "$MODEL_DIR"

# Install llama-cpp-python binding if not installed
if ! python3 -c "import llama_cpp" >/dev/null 2>&1; then
    echo "Installing llama-cpp-python binding..."
    pip3 install llama-cpp-python --break-system-packages --quiet
fi

# Download the model
#if [ ! -f "$MODEL_FILE" ]; then
    echo "Downloading NEMS AI Model... This may take a few minutes."
    curl -L -o "$MODEL_FILE" "$MODEL_URL"
#fi

# Set permissions
chmod 755 /usr/local/bin/nems-ai
chmod 755 /usr/local/bin/notify-by-nems-ai
chmod 644 "$MODEL_FILE"

echo "NEMS AI installation complete."

exit 0
