#!/bin/sh
set -e

# Ensure Ollama service is running for model creation
if systemctl is-active --quiet ollama; then
    echo "Ollama service is active."
else
    echo "Starting Ollama service..."
    systemctl start ollama || true
    sleep 3
fi

# Detect Total RAM in Megabytes
TOTAL_RAM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
TOTAL_RAM_MB=$((TOTAL_RAM_KB / 1024))

# Select hardware tier
if [ "$TOTAL_RAM_MB" -ge 15000 ]; then
    # 16GB+ Systems (VMs / Heavy x86 bare metal)
    BASE_MODEL="llama3.1:8b"
elif [ "$TOTAL_RAM_MB" -ge 3800 ]; then
    # 4GB - 8GB Systems (RPi 4/5 4GB or 8GB)
    BASE_MODEL="llama3.2:3b"
else
    # < 4GB Systems (RPi 3 / RPi 4 2GB)
    BASE_MODEL="llama3.2:1b"
fi

echo "Detected ${TOTAL_RAM_MB}MB RAM. Selected base model: ${BASE_MODEL}"

# Pull base model and build 'nems-ai' model alias
if command -v ollama >/dev/null 2>&1; then
    echo "Pulling ${BASE_MODEL} payload..."
    ollama pull "$BASE_MODEL"

    # Create temporary Modelfile
    TMP_MODELFILE=$(mktemp)
    cat <<EOF > "$TMP_MODELFILE"
FROM ${BASE_MODEL}
PARAMETER temperature 0.2
PARAMETER num_predict 60
EOF

    echo "Binding ${BASE_MODEL} to 'nems-ai' Ollama alias..."
    ollama create nems-ai -f "$TMP_MODELFILE"
    rm -f "$TMP_MODELFILE"
fi

exit 0
